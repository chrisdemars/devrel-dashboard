# Copy the variables you need into .env (gitignored) and fill them in.
# Anything left blank shows up as "not_configured" in `npm run status`.
#
# .env is for secrets and machine-specific settings. Organization details
# (name, package names, GA4 key events, labels) go in config/devrel.config.ts.

# ---- General ----------------------------------------------------------------
# Where the dashboards read data from. "sample" shows generated data for a
# fictional organization and needs no setup. "supabase" is not available yet.
DATA_MODE=sample
COLLECT_LOOKBACK_DAYS=28

# ---- CLI distribution -------------------------------------------------------
# Optional overrides for `packages` in devrel.config.ts. Comma-separated lists.
# When one is set, it replaces the matching list from the config.
CLI_NPM_PACKAGES=
CLI_HOMEBREW_FORMULAE=
CLI_HOMEBREW_CASKS=
CLI_PYPI_PACKAGES=
CLI_DOCKER_IMAGES=
# owner/repo for your tool, SDKs, samples...
CLI_GITHUB_REPOS=
# Optional: read-only token for private repos / higher rate limits
GITHUB_TOKEN=

# ---- GA4 (blog and site) ----------------------------------------------------
GA4_PROPERTY_ID=
# Service account key; keep it in ./secrets/ (gitignored)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/ga4-service-account.json
GA4_BLOG_PATH_PREFIX=/blog/
# Optional override for `ga4.keyEvents` in devrel.config.ts,
# e.g. product_click,demo_request,install_click
GA4_KEY_EVENTS=

# ---- Social, video, streams -------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_IDS=
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=

# ---- Placeholders: no access yet --------------------------------------------
CRM_PROVIDER=
HUBSPOT_ACCESS_TOKEN=
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
PRODUCT_TELEMETRY_API_URL=
PRODUCT_TELEMETRY_API_TOKEN=
PRODUCT_SIGNUPS_API_URL=
PRODUCT_SIGNUPS_API_TOKEN=
