{
  "name": "devrel-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source dashboard for tracking DevRel activity and impact",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "status": "node --env-file-if-exists=.env --import tsx scripts/collect.ts status",
    "collect": "node --env-file-if-exists=.env --import tsx scripts/collect.ts collect",
    "sample-data": "node --env-file-if-exists=.env --import tsx scripts/sample-data.ts",
    "utm": "node --env-file-if-exists=.env --import tsx scripts/utm.ts"
  },
  "dependencies": {
    "@google-analytics/data": "^7.3.0",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
